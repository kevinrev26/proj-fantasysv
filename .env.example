# Development and Production.
ENVIRONMENT=dev

# PostgreSQL
POSTGRES_USER=fantasy_user
POSTGRES_PASSWORD=fantasy_pass
POSTGRES_DB=fantasy_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://redis:6379/0

# Secret key for sessions/JWT
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the example value in production — the app will refuse to start if you do.
SECRET_KEY=

# CORS — comma-separated list of allowed frontend origins.
# Development default (localhost origins):
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1
# Production example (set to your actual domain):
# ALLOWED_ORIGINS=https://fantasydvoleasv.com

# Celery
BROKER_CONNECTION_RETRY_ON_STARTUP=True

# Sentry
SENTRY_DSN=

# Admin Defaults
DEFAULT_ADMIN_EMAIL=admin@fantasysv.com
DEFAULT_ADMIN_PASSWORD=admin

# Analytics
UMAMI_USER=u_user
UMAMI_PASSWORD=pazzword
UMAMI_DATABASE=umamidb
UMAMI_DATABASE_URL=DATABASE_URL=postgresql://${UMAMI_USER}:${UMAMI_PASSWORD}@db:5432/${UMAMI_DATABASE}
UMAMI_APP_SECRET=random_stuff

# We need umami script id first so bring up that infra section first with:
# docker compose up umami_db umami
# Add to your .env:
UMAMI_WEBSITE_ID=the-uuid-from-umami
UMAMI_SCRIPT_URL=http://localhost:3000/script.js
